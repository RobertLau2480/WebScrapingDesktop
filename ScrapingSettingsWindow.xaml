<Window x:Class="WebScrapingDesktop.ScrapingSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="抓取设置" Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,-26">
        <StackPanel Margin="10">
            <GroupBox Header="主链接" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                        <TextBlock Text="URL" />
                        <TextBox x:Name="MainUrlBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="XPath 1" />
                        <TextBox x:Name="MainXp1Box" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="XPath 2" />
                        <TextBox x:Name="MainXp2Box" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Text="XPath 3" />
                        <TextBox x:Name="MainXp3Box" />
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="1" Content="测试" Width="50" Height="20" VerticalAlignment="Bottom" Margin="4,0,0,0" Click="TestMain_Click" />
                </Grid>
            </GroupBox>

            <GroupBox Header="备用链接" Padding="5" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                        <TextBlock Text="URL" />
                        <TextBox x:Name="BackupUrlBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="XPath 1" />
                        <TextBox x:Name="BackupXp1Box" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="XPath 2" />
                        <TextBox x:Name="BackupXp2Box" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Text="XPath 3" />
                        <TextBox x:Name="BackupXp3Box" />
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="1" Content="测试" Width="50" Height="20" VerticalAlignment="Bottom" Margin="4,0,0,0" Click="TestBackup_Click" />
                </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <TextBlock x:Name="TestStatus" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="确定" Width="60" Click="Ok_Click" />
                <Button Content="取消" Width="60" Margin="6,0,0,0" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>