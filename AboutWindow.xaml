<Window x:Class="WebScrapingDesktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WebScrapingDesktop"
        Title="关于" Height="180" Width="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{x:Static local:Branding.AppName}" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="{x:Static local:Branding.Version}" Margin="0,4" />
        <TextBlock Text="{x:Static local:Branding.Author}" />
        <TextBlock Margin="0,8">
            <Hyperlink NavigateUri="https://space.bilibili.com/509648854" RequestNavigate="Hyperlink_RequestNavigate">
                个人主页：space.bilibili.com/509648854
            </Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>