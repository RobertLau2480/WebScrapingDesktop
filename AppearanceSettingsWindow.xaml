<Window x:Class="WebScrapingDesktop.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观设置" Height="520" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <GroupBox Header="主窗口" Padding="5">
                <StackPanel>
                    <TextBlock Text="背景颜色" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBox x:Name="ColorHexBox" Width="80" TextChanged="ColorHexBox_TextChanged" />
                        <Button Content="选色" Margin="6,0,0,0" Click="PickColor_Click" Width="40" />
                        <Rectangle x:Name="ColorPreview" Width="24" Height="24" RadiusX="4" RadiusY="4" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="不透明度" Margin="0,6,0,0"/>
                    <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F0}%}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="文字元素 1" Padding="5" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="字体" />
                    <ComboBox x:Name="Font1Combo" />
                    <TextBlock Text="字号" Margin="0,4,0,0" />
                    <Slider x:Name="Font1SizeSlider" Minimum="8" Maximum="48" />
                    <TextBlock Text="{Binding ElementName=Font1SizeSlider, Path=Value, StringFormat={}{0:F0}pt}" />
                    <TextBlock Text="颜色" />
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBox x:Name="Font1Color" Width="80" TextChanged="Font1Color_TextChanged" />
                        <Button Content="选色" Margin="6,0,0,0" Click="PickFont1Color_Click" Width="40" />
                        <Rectangle x:Name="Font1ColorPreview" Width="24" Height="24" RadiusX="4" RadiusY="4" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox x:Name="Font1BoldCheck" Content="粗体" VerticalAlignment="Center" />
                        <CheckBox x:Name="Font1ItalicCheck" Content="斜体" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="文字元素 2" Padding="5" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="字体" />
                    <ComboBox x:Name="Font2Combo" />
                    <TextBlock Text="字号" />
                    <Slider x:Name="Font2SizeSlider" Minimum="8" Maximum="48" />
                    <TextBlock Text="{Binding ElementName=Font2SizeSlider, Path=Value, StringFormat={}{0:F0}pt}" />
                    <TextBlock Text="颜色" />
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBox x:Name="Font2Color" Width="80" TextChanged="Font2Color_TextChanged" />
                        <Button Content="选色" Margin="6,0,0,0" Click="PickFont2Color_Click" Width="40" />
                        <Rectangle x:Name="Font2ColorPreview" Width="24" Height="24" RadiusX="4" RadiusY="4" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox x:Name="Font2BoldCheck" Content="粗体" VerticalAlignment="Center" />
                        <CheckBox x:Name="Font2ItalicCheck" Content="斜体" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="文字元素 3" Padding="5" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="字体" />
                    <ComboBox x:Name="Font3Combo" />
                    <TextBlock Text="字号" />
                    <Slider x:Name="Font3SizeSlider" Minimum="8" Maximum="48" />
                    <TextBlock Text="{Binding ElementName=Font3SizeSlider, Path=Value, StringFormat={}{0:F0}pt}" />
                    <TextBlock Text="颜色" />
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBox x:Name="Font3Color" Width="80" TextChanged="Font3Color_TextChanged" />
                        <Button Content="选色" Margin="6,0,0,0" Click="PickFont3Color_Click" Width="40" />
                        <Rectangle x:Name="Font3ColorPreview" Width="24" Height="24" RadiusX="4" RadiusY="4" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox x:Name="Font3BoldCheck" Content="粗体" VerticalAlignment="Center" />
                        <CheckBox x:Name="Font3ItalicCheck" Content="斜体" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="确定" Width="60" Click="Ok_Click" IsDefault="True" />
                <Button Content="取消" Width="60" Margin="6,0,0,0" Click="Cancel_Click" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>